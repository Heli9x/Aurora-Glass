[Unit]
Description=Filey distributed encode helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/filey-helper/env
ExecStart=/usr/bin/env python3 %h/.local/share/filey-helper/helper_client.py --workers ${FS_WORKERS}
Restart=on-failure
RestartSec=5
WorkingDirectory=%h/.local/share/filey-helper

[Install]
WantedBy=default.target
